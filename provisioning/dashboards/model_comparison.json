          "query": "import \"math\"\n\npredicted =\n from(bucket: \"model_comparison\")\n |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n |> filter(fn: (r) =>\n r._measurement == \"metric_results\" and\n r.model_type == \"predicted\" and\n r._field == \"${metric_choice}\"\n )\n |> keep(columns: [\"_time\", \"_value\", \"support_level\"])\n |> sort(columns: [\"_time\"])\n |> map(fn: (r) => ({r with one: 1}))\n |> cumulativeSum(columns: [\"one\"])\n\npredicted\n |> map(fn: (r) => ({\n xcat: string(v: r._value) + \" #\" + string(v: r.one),\n high: if r.support_level == \"high\" then r._value else 0.0,\n medium: if r.support_level == \"medium\" then r._value else 0.0,\n low: if r.support_level == \"low\" then r._value else 0.0\n }))\n |> group()\n |> sort(columns: [\"xcat\"])",
