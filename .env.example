# === container hosts ===
BACKEND_HOST=0.0.0.0
INFLUXDB_HOST=influxdb
GRAFANA_HOST=grafana

# === ports ===
INFLUXDB_PORT=8086
GRAFANA_PORT=3000
BACKEND_PORT=8000
FRONTEND_PORT=5173

# === internal container connections ===
BACKEND_CONTAINER_PORT=8000
INFLUXDB_CONTAINER_PORT=8086
GRAFANA_CONTAINER_PORT=3000
FRONTEND_CONTAINER_PORT=3000

# === internal container URLs ===
INFLUXDB_URL=http://influxdb:8086
FRONTEND_BACKEND_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GRAFANA_DASHBOARD_URL='http://localhost:3000/d/model-comparison/model-comparison?orgId=1&kiosk'

# === backend runtime config ===
DATA_DIR=data
COMPARISON_PATH=comparison.json
MODEL_PATH=data/model.json
EXPERIMENTS_DIR=data/experiments

# === INFLUXDB ===
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin
INFLUXDB_ORG=mlops
INFLUXDB_BUCKET=model_comparison
INFLUXDB_TOKEN=
INFLUXDB_RETENTION=365d
INFLUXDB_REQUIRED=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3100,http://127.0.0.1:3100

# === Grafana ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
